diff --git a/.github/workflows/scripts/release-check-blockers.sh b/.github/workflows/scripts/release-check-blockers.sh
new file mode 100755
index 000000000..72f628df6
--- /dev/null
+++ b/.github/workflows/scripts/release-check-blockers.sh
@@ -0,0 +1,7 @@
+#!/bin/bash -ex
+
+BLOCKERS=$( gh issue list --search "label:release:blocker" --json url --jq '.[].url' --repo "${REPO}" )
+if [ "${BLOCKERS}" != "" ]; then
+    echo "Release blockers in ${REPO} repo: ${BLOCKERS}"
+    exit 1
+fi
