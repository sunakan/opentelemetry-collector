+func waitMetricsReady(t *testing.T, metricsPort string) {
+	require.EventuallyWithT(t, func(t *assert.CollectT) {
+		_ = readMetrics(t, metricsPort)
+	}, 10*time.Second, 100*time.Millisecond, "collector failed to start")
