+++ b/cmd/builder/test/test.sh
@@ -59,6 +59,8 @@ test_build_config() {
     "${out}/${test}" --config "./test/${test}.otel.yaml" > "${out}/otelcol.log" 2>&1 &
     pid=$!
 
+    # each attempt pauses for 100ms before retrying
