+}
+
+func (na *AddrConfig) Validate() error {
+	switch na.Transport {
+	case TransportTypeTCP,
+		TransportTypeTCP4,
+		TransportTypeTCP6,
+		TransportTypeUDP,
+		TransportTypeUDP4,
+		TransportTypeUDP6,
