+// Delete a path from the Conf.
+// If the path exists, deletes it and returns true.
+// If the path does not exist, does nothing and returns false.
+func (l *Conf) Delete(key string) bool {
+	wasSet := l.IsSet(key)
+	l.k.Delete(key)
+	return wasSet
+}
