diff --git a/Makefile.Common b/Makefile.Common
index 494a5d87a..1f0369d75 100644
--- a/Makefile.Common
+++ b/Makefile.Common
@@ -6,11 +6,12 @@ COVER_PKGS := $(shell go list ./... | tr "\n" ",")
 
 CURR_MOD := $(shell go list -m | tr '/' '-' )
 
-GOTEST_TIMEOUT?=240s
-GOTEST_OPT?= -race -timeout $(GOTEST_TIMEOUT)
 GOCMD?= go
 GOOS := $(shell $(GOCMD) env GOOS)
 GOARCH := $(shell $(GOCMD) env GOARCH)
+GOTEST_TIMEOUT?=240s
+# -race is not supported on windows arm64
+GOTEST_OPT?= -timeout $(GOTEST_TIMEOUT) $(if $(and $(filter windows,$(GOOS)), $(filter arm64,$(GOARCH))),, -race)
 
 # SRC_ROOT is the top of the source tree.
 SRC_ROOT := $(shell git rev-parse --show-toplevel)
