+func (md MetricData) Size() int {
+	size := 0
+	for i := 0; i < len(*md.orig); i++ {
+		if (*md.orig)[i] == nil {
+			continue
+		}
+		size += (*(*md.orig)[i]).Size()
+	}
+	return size
+}
