+
+func sanitizePrometheusKey(str string) string {
+	runeFilterMap := func(r rune) rune {
+		if unicode.IsDigit(r) || unicode.IsLetter(r) || r == '_' {
+			return r
+		}
+		return '_'
+	}
+	return strings.Map(runeFilterMap, str)
