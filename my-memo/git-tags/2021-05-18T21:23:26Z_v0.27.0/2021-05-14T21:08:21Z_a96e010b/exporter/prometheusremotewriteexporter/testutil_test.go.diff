+func getResource(resources ...string) pdata.Resource {
+	resource := pdata.NewResource()
+
+	for i := 0; i < len(resources); i += 2 {
+		resource.Attributes().Upsert(resources[i], pdata.NewAttributeValueString(resources[i+1]))
+	}
+
+	return resource
+}
