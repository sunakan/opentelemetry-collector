+		for i := 0; i < ms.Len(); i++ {
+			ms.At(i).SetName(getTestLogName(1, i))
+		}
+	}
+
+	b.ReportAllocs()
+	b.ResetTimer()
+	for n := 0; n < b.N; n++ {
