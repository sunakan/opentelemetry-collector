 	// ConsumeTraces receives pdata.Traces for consumption.
 	ConsumeTraces(ctx context.Context, td pdata.Traces) error
 }
@@ -38,6 +54,7 @@ type Traces interface {
 // Logs is an interface that receives pdata.Logs, processes it
