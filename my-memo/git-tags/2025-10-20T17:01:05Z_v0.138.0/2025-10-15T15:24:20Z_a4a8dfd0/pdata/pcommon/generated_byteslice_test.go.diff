+func TestByteSliceRemoveIf(t *testing.T) {
+	emptySlice := NewByteSlice()
+	emptySlice.RemoveIf(func(el byte) bool {
+		t.Fail()
+		return false
+	})
+
+	ms := NewByteSlice()
+	ms.FromRaw([]byte{1, 2, 3})
+	pos := 0
+	ms.RemoveIf(func(el byte) bool {
+		pos++
+		return pos%2 == 1
+	})
+	assert.Equal(t, pos/2, ms.Len())
+}
