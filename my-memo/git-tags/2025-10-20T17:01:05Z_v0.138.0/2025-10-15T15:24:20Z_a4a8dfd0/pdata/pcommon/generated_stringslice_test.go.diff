+func TestStringSliceRemoveIf(t *testing.T) {
+	emptySlice := NewStringSlice()
+	emptySlice.RemoveIf(func(el string) bool {
+		t.Fail()
+		return false
+	})
+
+	ms := NewStringSlice()
+	ms.FromRaw([]string{"a", "b", "c"})
+	pos := 0
+	ms.RemoveIf(func(el string) bool {
+		pos++
+		return pos%2 == 1
+	})
+	assert.Equal(t, pos/2, ms.Len())
+}
