+func TestFloat64SliceRemoveIf(t *testing.T) {
+	emptySlice := NewFloat64Slice()
+	emptySlice.RemoveIf(func(el float64) bool {
+		t.Fail()
+		return false
+	})
+
+	ms := NewFloat64Slice()
+	ms.FromRaw([]float64{1.1, 2.2, 3.3})
+	pos := 0
+	ms.RemoveIf(func(el float64) bool {
+		pos++
+		return pos%2 == 1
+	})
+	assert.Equal(t, pos/2, ms.Len())
+}
