+func TestUInt64SliceRemoveIf(t *testing.T) {
+	emptySlice := NewUInt64Slice()
+	emptySlice.RemoveIf(func(el uint64) bool {
+		t.Fail()
+		return false
+	})
+
+	ms := NewUInt64Slice()
+	ms.FromRaw([]uint64{1, 2, 3})
+	pos := 0
+	ms.RemoveIf(func(el uint64) bool {
+		pos++
+		return pos%2 == 1
+	})
+	assert.Equal(t, pos/2, ms.Len())
+}
