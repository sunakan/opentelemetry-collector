+func TestInt64SliceRemoveIf(t *testing.T) {
+	emptySlice := NewInt64Slice()
+	emptySlice.RemoveIf(func(el int64) bool {
+		t.Fail()
+		return false
+	})
+
+	ms := NewInt64Slice()
+	ms.FromRaw([]int64{1, 2, 3})
+	pos := 0
+	ms.RemoveIf(func(el int64) bool {
+		pos++
+		return pos%2 == 1
+	})
+	assert.Equal(t, pos/2, ms.Len())
+}
