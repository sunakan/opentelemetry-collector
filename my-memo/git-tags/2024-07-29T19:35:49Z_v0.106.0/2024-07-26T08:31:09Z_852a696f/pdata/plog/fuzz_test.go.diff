+
+func FuzzUnmarshalJsonLogs(f *testing.F) {
+	f.Fuzz(func(_ *testing.T, data []byte) {
+		u := &JSONUnmarshaler{}
+		//nolint: errcheck
+		_, _ = u.UnmarshalLogs(data)
+	})
+}
+
+func FuzzUnmarshalPBLogs(f *testing.F) {
+	f.Fuzz(func(_ *testing.T, data []byte) {
+		u := &ProtoUnmarshaler{}
+		//nolint: errcheck
+		_, _ = u.UnmarshalLogs(data)
+	})
+}
