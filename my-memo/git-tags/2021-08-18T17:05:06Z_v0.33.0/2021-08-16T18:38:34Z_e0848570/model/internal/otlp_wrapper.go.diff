+func numberDataPointsLabelsToAttributes(dps []*otlpmetrics.NumberDataPoint) {
+	for i := range dps {
+		if dps[i].Labels != nil && dps[i].Attributes != nil {
+			continue
+		}
+		if dps[i].Labels != nil {
+			dps[i].Attributes = labelsToAttributes(dps[i].Labels)
+		}
+	}
+}
