+func combineErrors(errs []error) error {
+	if len(errs) == 0 {
+		return nil
+	}
+
+	// Otherwise
+	buf := new(strings.Builder)
+	for _, err := range errs {
+		fmt.Fprintf(buf, "%v\n", err)
+	}
+	return errors.New(buf.String())
