diff --git a/appveyor.yml b/appveyor.yml
new file mode 100644
index 000000000..e9e064f01
--- /dev/null
+++ b/appveyor.yml
@@ -0,0 +1,26 @@
+version: "{build}"
+
+platform: x64
+
+clone_folder: c:\gopath\src\com.github\census-instrumentation\opencensus-service
+
+environment:
+  GOPATH: 'c:\gopath'
+  GOVERSION: '1.11'
+  GO111MODULE: 'on'
+  CGO_ENABLED: '0' # See: https://github.com/appveyor/ci/issues/2613
+
+install:
+  - set PATH=%GOPATH%\bin;c:\go\bin;%PATH%
+  - go version
+  - go env
+  - choco install make
+
+build: false
+deploy: false
+
+test_script:
+  - cd %APPVEYOR_BUILD_FOLDER%
+  - make install-tools
+  - go build -v .\...
+  - go test -v .\... # No -race because cgo is disabled
