+
+func notWithinOneMillisecond(sentNs uint64, recdNs uint64) bool {
+	var diff uint64
+	if sentNs > recdNs {
+		diff = sentNs - recdNs
+	} else {
+		diff = recdNs - sentNs
+	}
+	return diff > uint64(1100000)
+}
