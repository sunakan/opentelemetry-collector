+		SpanNames: []string{"apply", "dont_apply"},
+		MatchType: MatchTypeStrict,
+	}
+	oCfg.Exclude = &MatchProperties{
+		SpanNames: []string{"dont_apply"},
+		MatchType: MatchTypeStrict,
