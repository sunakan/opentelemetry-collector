 // Begin writing JSON. Call first.
 func (jw *jsonWriter) Begin() error {
 	_, err := io.WriteString(jw.writer, "{\n")
@@ -197,6 +202,43 @@ func (e *Exporter) ConsumeMetricsData(ctx context.Context, md consumerdata.Metri
