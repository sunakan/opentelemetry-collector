-				host.ReportFatalError(err)
+		ticker := time.NewTicker(hmr.config.CollectionInterval)
+		defer ticker.Stop()
+
+		for {
+			select {
+			case <-ticker.C:
+				hmr.ScrapeMetrics(context.Background(), hmr.scrapers)
