+		tagsCount++
+	}
+	status := span.Status()
+	if !status.IsNil() {
+		statusCodeTag, statusCodeTagFound = getTagFromStatusCode(status.Code())
+		if statusCodeTagFound {
+			tagsCount++
+		}
+
+		errorTag, errorTagFound = getErrorTagFromStatusCode(status.Code())
