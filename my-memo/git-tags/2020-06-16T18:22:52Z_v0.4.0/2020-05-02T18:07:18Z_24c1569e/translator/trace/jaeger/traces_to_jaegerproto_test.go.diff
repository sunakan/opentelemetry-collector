+	assert.EqualValues(t, errTag, got)
+
+	got, ok = getErrorTagFromStatusCode(pdata.StatusCode(otlptrace.Status_NotFound))
+	assert.True(t, ok)
+	assert.EqualValues(t, errTag, got)
