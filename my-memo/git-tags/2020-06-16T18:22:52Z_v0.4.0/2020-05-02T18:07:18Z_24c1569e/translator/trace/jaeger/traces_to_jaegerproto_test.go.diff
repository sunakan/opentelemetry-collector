+func TestGetErrorTagFromStatusCode(t *testing.T) {
+	errTag := model.KeyValue{
+		Key:   tracetranslator.TagError,
+		VBool: true,
+		VType: model.ValueType_BOOL,
+	}
+
+	got, ok := getErrorTagFromStatusCode(pdata.StatusCode(otlptrace.Status_Ok))
