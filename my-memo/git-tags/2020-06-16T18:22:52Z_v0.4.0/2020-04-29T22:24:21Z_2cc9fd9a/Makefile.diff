diff --git a/Makefile b/Makefile
index d277d5e89..d5772043e 100644
--- a/Makefile
+++ b/Makefile
@@ -29,6 +29,8 @@ LINT=golangci-lint
 IMPI=impi
 GOSEC=gosec
