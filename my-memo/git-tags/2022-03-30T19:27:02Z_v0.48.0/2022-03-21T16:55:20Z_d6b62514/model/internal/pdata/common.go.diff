+	case float64:
+		return NewValueDouble(tv)
+	case bool:
+		return NewValueBool(tv)
+	case []byte:
+		return NewValueBytes(tv)
+	case map[string]interface{}:
+		mv := NewValueMap()
+		NewMapFromRaw(tv).CopyTo(mv.MapVal())
