+	}
+	dest.WriteArrayEnd()
+}
+
+// UnmarshalJSONOrigExemplarSlice unmarshals all properties from the current struct from the source iterator.
+func UnmarshalJSONOrigExemplarSlice(iter *json.Iterator) []otlpmetrics.Exemplar {
