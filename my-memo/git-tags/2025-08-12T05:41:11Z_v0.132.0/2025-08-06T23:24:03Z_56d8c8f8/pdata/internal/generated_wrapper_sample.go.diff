+		dest.WriteInt32(orig.GetLinkIndex())
+	}
+	if len(orig.TimestampsUnixNano) > 0 {
+		dest.WriteObjectField("timestampsUnixNano")
+		MarshalJSONOrigUint64Slice(orig.TimestampsUnixNano, dest)
+	}
+	dest.WriteObjectEnd()
+}
