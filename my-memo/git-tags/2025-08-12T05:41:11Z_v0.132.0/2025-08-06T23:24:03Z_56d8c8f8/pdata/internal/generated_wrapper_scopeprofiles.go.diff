+	}
+	dest.WriteObjectEnd()
+}
+
+// UnmarshalJSONOrigScopeProfiles unmarshals all properties from the current struct from the source iterator.
+func UnmarshalJSONOrigScopeProfiles(orig *otlpprofiles.ScopeProfiles, iter *json.Iterator) {
