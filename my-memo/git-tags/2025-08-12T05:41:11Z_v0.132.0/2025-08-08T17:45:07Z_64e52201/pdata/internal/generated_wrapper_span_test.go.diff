+	assert.Equal(t, len(buf), SizeProtoOrigSpan(src))
+
+	dest := &otlptrace.Span{}
+	require.NoError(t, UnmarshalProtoOrigSpan(dest, buf))
+	assert.Equal(t, src, dest)
