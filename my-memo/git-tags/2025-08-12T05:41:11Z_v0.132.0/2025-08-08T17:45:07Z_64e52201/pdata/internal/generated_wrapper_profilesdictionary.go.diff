+		n += 1 + proto.Sov(uint64(l)) + l
+	}
+	for i := range orig.LocationTable {
+		l = SizeProtoOrigLocation(orig.LocationTable[i])
+		n += 1 + proto.Sov(uint64(l)) + l
+	}
+	for i := range orig.FunctionTable {
+		l = SizeProtoOrigFunction(orig.FunctionTable[i])
