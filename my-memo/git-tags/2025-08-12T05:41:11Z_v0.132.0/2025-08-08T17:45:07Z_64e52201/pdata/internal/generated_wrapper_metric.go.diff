+	case *otlpmetrics.Metric_Summary:
+		l = SizeProtoOrigSummary(orig.Data.(*otlpmetrics.Metric_Summary).Summary)
+		n += 1 + proto.Sov(uint64(l)) + l
+	}
+	for i := range orig.Metadata {
+		l = SizeProtoOrigKeyValue(&orig.Metadata[i])
