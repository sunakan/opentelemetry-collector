+
+func newNoopExportSender() sender.Sender[request.Request] {
+	return sender.NewSender(func(ctx context.Context, _ request.Request) error {
+		select {
+		case <-ctx.Done():
+			return ctx.Err() // Returns the cancellation error
+		default:
+			return nil
+		}
+	})
+}
