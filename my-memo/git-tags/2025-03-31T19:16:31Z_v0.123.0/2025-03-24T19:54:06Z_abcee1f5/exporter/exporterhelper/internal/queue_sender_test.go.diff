+func TestSizeConfig_Validate(t *testing.T) {
+	cfg := SizeConfig{
+		Sizer:   request.SizerTypeBytes,
+		MaxSize: 10,
+		MinSize: 100,
+	}
+	require.EqualError(t, cfg.Validate(), "unsupported sizer type: {\"bytes\"}")
