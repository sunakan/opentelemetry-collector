+		"num_consumers": 2,
+		"queue_size":    100,
+		"blocking":      true,
+	})
+
+	qCfg := QueueConfig{}
+	assert.False(t, qCfg.BlockOnOverflow)
+	require.NoError(t, conf.Unmarshal(&qCfg))
+	assert.True(t, qCfg.BlockOnOverflow)
+	assert.True(t, qCfg.hasBlocking)
