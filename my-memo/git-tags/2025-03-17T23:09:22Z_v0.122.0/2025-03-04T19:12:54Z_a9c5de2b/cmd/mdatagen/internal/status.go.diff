 	"go.opentelemetry.io/collector/component"
 )
@@ -128,6 +129,9 @@ func (s *Status) Validate() error {
 	if err := s.Stability.Validate(); err != nil {
 		errs = errors.Join(errs, err)
 	}
+	if err := s.Deprecation.Validate(s.Stability); err != nil {
