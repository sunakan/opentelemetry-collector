diff --git a/pdata/pcommon/slice_test.go b/pdata/pcommon/slice_test.go
index b3628ff99..acd07587d 100644
--- a/pdata/pcommon/slice_test.go
+++ b/pdata/pcommon/slice_test.go
@@ -150,3 +150,33 @@ func TestInvalidSlice(t *testing.T) {
 	assert.Panics(t, func() { es.AsRaw() })
 	assert.Panics(t, func() { _ = es.FromRaw([]any{3}) })
 }
+
+func TestSliceEqual(t *testing.T) {
+	es := NewSlice()
+	es2 := NewSlice()
+	assert.True(t, es.Equal(es2))
+
+	v := es.AppendEmpty()
+	v.SetStr("test")
+	assert.False(t, es.Equal(es2))
+
+	v = es2.AppendEmpty()
+	v.SetStr("test")
+	assert.True(t, es.Equal(es2))
+}
+
+func BenchmarkSliceEqual(b *testing.B) {
+	es := NewSlice()
+	v := es.AppendEmpty()
+	v.SetStr("test")
+	cmp := NewSlice()
+	v = cmp.AppendEmpty()
+	v.SetStr("test")
+
+	b.ResetTimer()
+	b.ReportAllocs()
+
+	for n := 0; n < b.N; n++ {
+		_ = es.Equal(cmp)
+	}
+}
