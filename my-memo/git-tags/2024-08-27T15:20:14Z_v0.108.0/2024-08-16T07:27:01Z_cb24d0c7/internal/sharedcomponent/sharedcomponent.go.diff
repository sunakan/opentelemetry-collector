+func (h *hostWrapper) Report(e *componentstatus.Event) {
+	// Only remember an event if it will be emitted and it has not been sent already.
+	h.lock.Lock()
+	if len(h.sources) > 0 && !slices.Contains(h.previousEvents, e) {
