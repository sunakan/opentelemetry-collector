+func getTypeString(metric *otlp.Metric) string {
+	switch metric.Data.(type) {
+	case *otlp.Metric_DoubleGauge:
+		return strconv.Itoa(int(pdata.MetricDataTypeDoubleGauge))
+	case *otlp.Metric_IntGauge:
