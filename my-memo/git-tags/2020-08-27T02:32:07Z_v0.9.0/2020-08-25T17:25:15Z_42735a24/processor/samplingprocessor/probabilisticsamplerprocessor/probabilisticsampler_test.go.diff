+func getSpanWithAttributes(key string, value pdata.AttributeValue) pdata.Span {
+	span := pdata.NewSpan()
+	span.InitEmpty()
+	span.SetName("spanName")
+	span.Attributes().InitFromMap(map[string]pdata.AttributeValue{key: value})
+	return span
+}
