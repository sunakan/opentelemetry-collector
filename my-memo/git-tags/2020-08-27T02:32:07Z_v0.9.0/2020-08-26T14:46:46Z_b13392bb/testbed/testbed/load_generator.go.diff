+func (lg *LoadGenerator) generateLog() {
+	logSender := lg.sender.(LogDataSender)
+
+	logData, done := lg.dataProvider.GenerateLogs()
+	if done {
+		return
+	}
+
+	err := logSender.SendLogs(logData)
+	if err == nil {
+		lg.prevErr = nil
+	} else if lg.prevErr == nil || lg.prevErr.Error() != err.Error() {
+		lg.prevErr = err
