+// MarshalJSONStream converts trace id into a hex string enclosed in quotes.
+func (sid SpanID) MarshalJSONStream(dest *json.Stream) {
+	if sid.IsEmpty() {
+		dest.WriteString("")
+		return
+	}
+	dest.WriteString(hex.EncodeToString(sid[:]))
+}
