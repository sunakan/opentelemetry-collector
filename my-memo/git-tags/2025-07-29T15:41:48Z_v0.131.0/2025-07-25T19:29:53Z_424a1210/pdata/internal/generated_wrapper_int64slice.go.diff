+// MarshalJSONStream marshals all properties from the current struct to the destination stream.
+func MarshalJSONStreamInt64Slice(ms Int64Slice, dest *json.Stream) {
+	dest.WriteArrayStart()
+	if len(*ms.orig) > 0 {
+		dest.WriteInt64((*ms.orig)[0])
+	}
