diff --git a/cmd/builder/.goreleaser.yml b/cmd/builder/.goreleaser.yml
new file mode 100644
index 000000000..ee05a0b2e
--- /dev/null
+++ b/cmd/builder/.goreleaser.yml
@@ -0,0 +1,33 @@
+before:
+  hooks:
+    - go mod download
+builds:
+  - flags:
+      - -trimpath
+    ldflags:
+      - -s -w -X go.opentelemetry.io/collector/builder/cmd.version={{.Version}} -X go.opentelemetry.io/collector/builder/cmd.date={{.Date}}
+    env:
+      - CGO_ENABLED=0
+    goos:
+      - linux
+      - windows
+      - darwin
+    goarch:
+      - amd64
+      - arm
+      - arm64
+    goarm:
+      - 6
+      - 7
+archives:
+  - format: binary
+checksum:
+  name_template: "checksums.txt"
+snapshot:
+  name_template: "{{ .Tag }}-next"
+changelog:
+  sort: asc
+  filters:
+    exclude:
+      - "^docs:"
+      - "^test:"
