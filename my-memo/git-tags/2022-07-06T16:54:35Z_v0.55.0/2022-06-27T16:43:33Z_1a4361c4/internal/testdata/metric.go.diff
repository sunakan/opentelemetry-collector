+func GenerateMetrics(count int) pmetric.Metrics {
+	md := generateMetricsOneEmptyInstrumentationScope()
+	ms := md.ResourceMetrics().At(0).ScopeMetrics().At(0).Metrics()
+	ms.EnsureCapacity(count)
