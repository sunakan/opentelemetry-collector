+		featuregate.Apply(map[string]bool{
+			useOtelForInternalMetricsfeatureGateID: originalFlag,
+		})
+	}()
+	featuregate.Apply(map[string]bool{
+		useOtelForInternalMetricsfeatureGateID: true,
+	})
+	testCollectorStartHelper(t)
