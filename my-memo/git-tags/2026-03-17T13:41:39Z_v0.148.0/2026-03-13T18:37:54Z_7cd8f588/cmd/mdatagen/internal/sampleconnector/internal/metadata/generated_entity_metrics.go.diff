+		if cfg.StringResourceAttr.Enabled {
+			res.Attributes().PutStr("string.resource.attr", e.stringResourceAttr)
+		}
+		if cfg.MapResourceAttr.Enabled {
+			res.Attributes().PutEmptyMap("map.resource.attr").FromRaw(e.mapResourceAttr)
+		}
