+func outputBinaryName(name string) string {
+	goos, ok := os.LookupEnv("GOOS")
+	if !ok || goos == "" {
+		goos = runtime.GOOS
+	}
+
+	if !strings.EqualFold(goos, "windows") {
+		return name
+	}
+	if strings.EqualFold(filepath.Ext(name), ".exe") {
+		return name
+	}
+	return name + ".exe"
+}
