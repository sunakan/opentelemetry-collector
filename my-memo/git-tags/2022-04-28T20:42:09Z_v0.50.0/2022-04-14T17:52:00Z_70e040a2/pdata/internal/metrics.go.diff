+func MetricsFromProto(orig otlpmetrics.MetricsData) Metrics {
+	return Metrics{orig: &otlpcollectormetrics.ExportMetricsServiceRequest{
+		ResourceMetrics: orig.ResourceMetrics,
+	}}
