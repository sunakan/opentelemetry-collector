+	mh := receivertest.NewMockHost()
+	err := exporters.StartAll(zap.NewNop(), mh)
+	assert.NoError(t, err)
+
+	assert.True(t, traceExporter.ExporterStarted)
+	assert.True(t, metricExporter.ExporterStarted)
