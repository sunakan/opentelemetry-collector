+}
+
+// WithHostProc overrides the /proc folder on Linux used by process telemetry.
+func WithHostProc(hostProc string) RegisterOption {
+	return registerOptionFunc(func(uo *registerOption) {
+		uo.hostProc = hostProc
+	})
+}
