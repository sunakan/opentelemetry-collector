+	assert.Equal(t, MetricDataTypeExponentialHistogram, tv.DataType())
+	tv.SetDataType(MetricDataTypeSummary)
+	fillTestSummary(tv.Summary())
+	assert.Equal(t, MetricDataTypeSummary, tv.DataType())
+}
