+func TestSinkLogExporter(t *testing.T) {
+	sink := new(SinkLogExporter)
+	md := testdata.GenerateLogDataOneLogNoResource()
+	want := make([]data.Logs, 0, 7)
+	for i := 0; i < 7; i++ {
+		err := sink.ConsumeLogs(context.Background(), md)
+		require.Nil(t, err)
+		want = append(want, md)
+	}
+	got := sink.AllLogs()
+	assert.Equal(t, want, got)
+}
