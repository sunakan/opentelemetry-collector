+func (b *logDataBuffer) logStringMap(description string, sm pdata.StringMap) {
+	if sm.Len() == 0 {
+		return
+	}
+
+	b.logEntry("%s:", description)
+	sm.ForEach(func(k string, v pdata.StringValue) {
+		b.logEntry("     -> %s: %s", k, v.Value())
+	})
+}
