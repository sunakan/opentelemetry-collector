+
+func metricsWithName(names []string) []*metricspb.Metric {
+	ret := make([]*metricspb.Metric, len(names))
+	for i, name := range names {
+		ret[i] = &metricspb.Metric{
+			MetricDescriptor: &metricspb.MetricDescriptor{
+				Name: name,
+			},
+		}
+	}
+	return ret
+}
